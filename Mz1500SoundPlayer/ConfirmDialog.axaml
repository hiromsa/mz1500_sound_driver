<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mz1500SoundPlayer.ConfirmDialog"
        Title="確認" Width="320" Height="140"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e">
    <StackPanel Margin="20" Spacing="15">
        <TextBlock x:Name="MessageText" Text="Message" Foreground="White" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,10,0,0">
            <Button Content="はい" Click="Yes_Click" Background="#007ACC" Foreground="White" Width="80" HorizontalContentAlignment="Center"/>
            <Button Content="いいえ" Click="No_Click" Background="#4e4e50" Foreground="White" Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>