<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mz1500SoundPlayer.InputDialog"
        Title="Input" Width="300" Height="150"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="MessageText" Text="Enter name:" Foreground="White"/>
        <TextBox x:Name="InputTextBox" Background="#333333" Foreground="White"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="OK" Click="Ok_Click" Background="#007ACC" Foreground="White" Width="70" HorizontalContentAlignment="Center"/>
            <Button Content="Cancel" Click="Cancel_Click" Background="#4e4e50" Foreground="White" Width="70" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
