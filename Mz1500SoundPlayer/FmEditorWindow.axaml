<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mz1500SoundPlayer"
        x:Class="Mz1500SoundPlayer.FmEditorWindow"
        x:DataType="local:FmEditorWindowViewModel"
        Title="FM音色エディタ"
        Width="1050" Height="850"
        MinWidth="900" MinHeight="750"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e" Foreground="#d4d4d4">
  
  <Window.Styles>
    <Style Selector="TreeViewItem" x:DataType="local:FmVoiceNodeViewModel">
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="#1e1e1e"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Background" Value="#2d2d30"/>
      <Setter Property="Foreground" Value="#d4d4d4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,1,0"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="#1e1e1e"/>
      <Setter Property="Foreground" Value="#ffffff"/>
      <Setter Property="BorderBrush" Value="#007ACC"/>
      <Setter Property="BorderThickness" Value="0,2,0,0"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="250, 4, *">
    
    <!-- Sidebar -->
    <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Background="#252526">
      <!-- Sidebar Header -->
      <Border Grid.Row="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="10">
        <Grid ColumnDefinitions="*, Auto">
          <TextBlock Grid.Column="0" Text="VOICES" FontWeight="Bold" FontSize="11" Foreground="#cccccc" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Content="➕" Click="NewFile_Click" Width="24" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" Background="Transparent" ToolTip.Tip="新規ファイル作成"/>
            <Button Content="📂" Click="OpenFolder_Click" Width="24" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" Background="Transparent" ToolTip.Tip="エクスプローラーで開く"/>
          </StackPanel>
        </Grid>
      </Border>
      
      <!-- TreeView -->
      <TreeView Grid.Row="1" ItemsSource="{Binding Library.Nodes}" Background="Transparent" DoubleTapped="TreeView_DoubleTapped" Margin="0,5,0,0">
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="local:FmVoiceNodeViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" PointerPressed="TreeNode_PointerPressed">
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="新規フォルダ" Click="ContextNewFolder_Click"/>
                  <MenuItem Header="新規ファイル" Click="ContextNewFile_Click"/>
                  <MenuItem Header="名前の変更" Click="ContextRename_Click"/>
                  <MenuItem Header="削除" Click="ContextDelete_Click"/>
                </ContextMenu>
              </StackPanel.ContextMenu>
                <TextBlock FontFamily="{StaticResource CodiconFont}" Text="&#xea83;" Foreground="#dcb67a" VerticalAlignment="Center" FontSize="16" IsVisible="{Binding IsDirectory}" />
                <TextBlock FontFamily="{StaticResource CodiconFont}" Text="&#xea7b;" Foreground="#cccccc" VerticalAlignment="Center" FontSize="16" IsVisible="{Binding !IsDirectory}" />
                <TextBlock Text="{Binding Name}" Foreground="#cccccc" VerticalAlignment="Center" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Grid>

    <GridSplitter Grid.Column="1" Background="#333333" ResizeDirection="Columns"/>

    <!-- Editor Area -->
    <Grid Grid.Column="2" RowDefinitions="*, Auto">
      <TabControl Grid.Row="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="local:FmEditorTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"/>
              <Button Content="✕" Click="CloseTab_Click" DataContext="{Binding}" Width="16" Height="16" Padding="0" FontSize="10" Background="Transparent" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate x:DataType="local:FmEditorTabViewModel">
            <local:FmEditorControl DataContext="{Binding Editor}" />
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>

        <Border Grid.Row="1" Background="#2d2d30" Padding="10" BorderBrush="#333333" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
              <Button Content="上書き保存 (Save)" Click="Save_Click" Background="#007ACC" Foreground="White" Padding="12,6" CornerRadius="2"/>
              <Button Content="別名で保存 (Save As)" Click="SaveAs_Click" Background="#4e4e50" Foreground="White" Padding="12,6" CornerRadius="2"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
              <Button Content="クリップボードにコピー" Click="CopyMml_Click" Background="#333333" Foreground="White" Padding="12,6" CornerRadius="2"/>
              <Button Content="トラッカーに反映 (Apply)" Click="Apply_Click" Background="#4e4e50" Foreground="White" Padding="12,6" CornerRadius="2"/>
            </StackPanel>
          </Grid>
        </Border>
    </Grid>

  </Grid>
</Window>
